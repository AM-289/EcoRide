{% extends 'base.html.twig' %}

{% block title %}Hello RideController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>
    
    <a class="btn btn-primary" href={{ path('ride.create')}}> Créer un trajet </a>

     {{knp_pagination_sortable(rides, 'ID', 'r.id')}}
     {{knp_pagination_sortable(rides, 'departure', 'r.departure')}}
             {{knp_pagination_sortable(rides, 'Car', 'r.car') }}

    <ul>
        {% for ride in rides %}
        <li>
            
                    {{ride.id}}
            
            <turbo-frame id="ride_{{ ride.id }}">
                <a href={{path('ride.mine.edit', {id: ride.id}) }}> {{ride.departure()}} {{ ride.arrival()}} </a>
            </turbo-frame>
                        {{ ride.car.brand }}
            <a class="btn btn-primary" href={{path('ride.edit', {id: ride.id, slug: ride.slug}) }}> Editer </a>
            <form action="{{path('ride.delete', {id: ride.id}) }}" method='post'>
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-danger" > Supprimer </a>
            </form>
        </li>
        {% endfor %}
    </ul>

        {{ knp_pagination_render(rides)}}
</div>
{% endblock %}
